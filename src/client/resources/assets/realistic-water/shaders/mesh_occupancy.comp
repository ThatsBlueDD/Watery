#version 450
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 1) readonly buffer Parts { Particle parts[]; };
layout(std430, binding = 2) readonly buffer Counters { uint counters[]; };
layout(std430, binding = 3) buffer Occupancy { uint occupancy[]; };
layout(push_constant) uniform PC { ivec4 a; ivec4 b; } pc;

void main() {
    uint i = GID_U;
    if (i >= counters[pc.a.x]) {
        return;
    }
    Particle p = parts[i];
    ivec3 c = ivec3(floor(p.pos.xyz));
    if (p.pos.w >= 0.0 && inBox(c)) {
        atomicAdd(occupancy[boxIndex(c)], 1u);
    }
}
