#version 450
#include "common.glsl"
layout(local_size_x = 1) in;
layout(std430, binding = 1) readonly buffer Start { uint start[]; };
layout(std430, binding = 2) readonly buffer Occupancy { uint occupancy[]; };
layout(std430, binding = 3) buffer Counters { uint counters[]; };
layout(push_constant) uniform PC { ivec4 a; ivec4 b; } pc;

void main() {
    int last = pc.a.y - 1;
    counters[pc.a.x] = last >= 0 ? start[last] + occupancy[last] : 0u;
}
