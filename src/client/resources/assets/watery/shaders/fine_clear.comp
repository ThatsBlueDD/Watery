#version 450
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 1) writeonly buffer Zb { int zb[]; };
layout(std430, binding = 2) readonly buffer Depth { uint depth[]; };
layout(push_constant) uniform PC { ivec4 a; ivec4 b; } pc;

void main() {
    int t = int(GID_U);
    if (t >= G.fineBoxMin.w) {
        return;
    }
    ivec3 d = G.fineBoxMax.xyz - G.fineBoxMin.xyz;
    ivec3 p = G.fineBoxMin.xyz + ivec3(t % d.x, (t / d.x) % d.y, t / (d.x * d.y));
    if (pc.a.y > 0 && depth[boxIndex(p / G.fine.w)] >= uint(pc.a.y)) {
        return;
    }
    int i = 4 * fineIndex(p);
    zb[i] = 0;
    zb[i + 1] = 0;
    zb[i + 2] = 0;
    zb[i + 3] = 0;
}
