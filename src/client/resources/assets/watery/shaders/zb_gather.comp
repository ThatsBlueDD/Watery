#version 450
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 1) readonly buffer Sorted { Particle sorted[]; };
layout(std430, binding = 2) readonly buffer Start { uint start[]; };
layout(std430, binding = 3) readonly buffer Occupancy { uint occupancy[]; };
layout(std430, binding = 4) readonly buffer Depth { uint depth[]; };
layout(std430, binding = 5) writeonly buffer Field { float field[]; };
layout(push_constant) uniform PC { ivec4 a; vec4 b; ivec4 c; } pc;

const float ZB_SCALE = 16384.0;

void main() {
    int block = int(GROUP_ID);
    if (block >= pc.c.x * pc.c.y * pc.c.z) {
        return;
    }
    int lid = int(gl_LocalInvocationID.x);
    ivec3 bc = ivec3(block % pc.c.x, (block / pc.c.x) % pc.c.y, block / (pc.c.x * pc.c.y));
    ivec3 v = G.fineBoxMin.xyz + bc * ivec3(8, 8, 4) + ivec3(lid & 7, (lid >> 3) & 7, lid >> 6);
    if (!inFine(v)) {
        return;
    }
    int sub = G.fine.w;
    int i = fineIndex(v);
    if (pc.a.z > 0 && depth[boxIndex(v / sub)] >= uint(pc.a.z)) {
        field[i] = 1.0;
        return;
    }
    float R = pc.b.x;
    float invR2 = 1.0 / (R * R);
    vec3 centre = vec3(v) + 0.5;
    ivec3 lo = max(ivec3(floor((centre - R) / float(sub))), G.boxMin.xyz);
    ivec3 hi = min(ivec3(floor((centre + R) / float(sub))), G.boxMax.xyz - 1);
    int sw = 0;
    ivec3 sd = ivec3(0);
    for (int z = lo.z; z <= hi.z; z++) {
        for (int y = lo.y; y <= hi.y; y++) {
            int row = boxIndex(ivec3(lo.x, y, z));
            for (int x = 0; x <= hi.x - lo.x; x++) {
                uint n = occupancy[row + x];
                if (n == 0u) {
                    continue;
                }
                uint s = start[row + x];
                for (uint j = 0u; j < n; j++) {
                    vec3 d = sorted[s + j].pos.xyz * float(sub) - centre;
                    float s2 = dot(d, d) * invR2;
                    if (s2 >= 1.0) {
                        continue;
                    }
                    float t = 1.0 - s2;
                    float k = t * t * t;
                    sw += int(k * ZB_SCALE + 0.5);
                    sd += ivec3(round(k * d * ZB_SCALE));
                }
            }
        }
    }
    if (float(sw) < 1.0) {
        field[i] = 0.0;
        return;
    }
    vec3 c = vec3(sd) / float(sw);
    float phi = length(c) - pc.b.y;
    field[i] = clamp(0.5 - 0.5 * phi, 0.0, 1.0) * smoothstep(pc.b.z, pc.b.w, float(sw) / ZB_SCALE);
}
